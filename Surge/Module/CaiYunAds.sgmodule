#!category = Polly-ai
# 上游来源：https://raw.githubusercontent.com/ddgksf2013/Rewrite/master/AdBlock/CaiYunAds.conf
# 上游版本：V1.0.8；原作者更新：2024-09-27
# 配置 SHA256：8ba68f9affa24bf759d157d1ab88c9920e1ea25b2cfc36720d0966ceb9220842
# 上游 caiyun_json.js SHA256：1a165112aac24bf3830fa47b77d223d85beffdeaf91ee96eef05ab9429b36844
# 转换与维护：Polly-ai/Wynston。上游 JS 原样镜像，Surge 桥接处理异常与重复完成。
# 已按用户要求保留两条会员标记规则，并显式追加 biz.cyapi.cn 的 MITM。
# 仅本机修改响应标记；不提供共享账号、真实订阅或服务器端付费权限。
# 需启用 MITM 并信任证书；不要与其他匹配这些接口的响应脚本重复启用。
# 每日同步配置和 JS；无变化不提交，下载或验证失败不发布。
# max-size=1048576：响应超过 1 MiB 时 Surge 跳过脚本并透传。

[Script]
caiyun_916a39e3323a = type=http-response, pattern=^https?:\/\/biz\.cyapi\.cn\/api\/v\d\/user_detail, requires-body=true, max-size=1048576, script-path=https://raw.githubusercontent.com/Polly-ai/Wynston/main/Surge/JavaScript/CaiYun/caiyun-surge.js, script-update-interval=86400, timeout=10
