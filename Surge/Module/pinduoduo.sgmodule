#!name = 拼多多净化底栏与弹窗
#!desc = 净化拼多多底栏与弹窗，屏蔽广告与推广入口。（2026-11-04 上游改版后范围）
#!category = Polly-ai
#!author = 怎么肥事

# 转换自 QX 格式，上游：https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/Pinduoduo.snippet
# 注意：净化逻辑在 Pinduoduo.js 里（上游脚本直链）；[Script] 需 Surge 开 MITM，脚本本身须兼容 Surge 的 $response / $done 写法。
# MITM 仅 api.pinduoduo.com 一个域名；[Rule] 的域名/IP 屏蔽不依赖 MITM。

[Rule]
DOMAIN,titan.pinduoduo.com,REJECT
DOMAIN,titan-mt.pinduoduo.com,REJECT
IP-CIDR,81.69.105.47/32,REJECT,no-resolve
IP-CIDR,81.69.104.17/32,REJECT,no-resolve
IP-CIDR,81.69.104.33/32,REJECT,no-resolve
IP-CIDR,81.69.204.21/32,REJECT,no-resolve
IP-CIDR,81.69.105.56/32,REJECT,no-resolve
IP-CIDR,81.69.116.33/32,REJECT,no-resolve
IP-CIDR,49.235.102.145/32,REJECT,no-resolve
IP-CIDR,49.235.102.190/32,REJECT,no-resolve
IP-CIDR,49.235.102.235/32,REJECT,no-resolve
IP-CIDR,111.231.130.223/32,REJECT,no-resolve
IP-CIDR,212.129.232.162/32,REJECT,no-resolve
IP-CIDR,111.231.95.17/32,REJECT,no-resolve
IP-CIDR,183.194.214.14/32,REJECT,no-resolve
IP-CIDR,183.194.214.20/32,REJECT,no-resolve
IP-CIDR,183.194.214.21/32,REJECT,no-resolve
IP-CIDR,117.185.244.145/32,REJECT,no-resolve

[Script]
pinduoduo_1 = type=http-response, pattern=^https:\/\/api\.pinduoduo\.com\/api\/alexa\/homepage\/hub(\/refresh)?\?, requires-body=true, script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/Pinduoduo.js
pinduoduo_2 = type=http-response, pattern=^https:\/\/api\.pinduoduo\.com\/api\/(aquarius|flow)\/hungary\/(window\/)?global\/, requires-body=true, script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/Pinduoduo.js
pinduoduo_3 = type=http-response, pattern=^https:\/\/api\.pinduoduo\.com\/api\/growth\/nagato\/app\/index\/gather, requires-body=true, script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/Pinduoduo.js

[MITM]
hostname = %APPEND% api.pinduoduo.com
