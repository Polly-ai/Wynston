#!name = 咪咕视频会员脚本
#!desc = 原配置全部规则和原JS完整转换，保留原有URL、请求头及Cookie改写
#!category = Polly-ai
#!author = 怎么肥事 (ZenmoFeiShi)
# 上游配置：https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/migu_vip_share.snippet
# 上游配置标注更新：2026-05-14
# 配置快照 SHA256：a3f8740f0d9caea42e7b8974215c7762bb8db8b64310236923f642317d28e83f
# 原始 JavaScript SHA256：ba3e803d4f5c305d0a003df1e92e948c5fd7de289c8f16b59c2d93259cfd8b6f
# 转换与维护：Polly-ai/Wynston。原JS按字节保留，仅转换QX模块语法。
# 已按用户要求保留既有共享凭据作为其报告已失效的学习样例。
# 未调用平台验证失效状态；不获取、刷新或自动同步任何会员凭据。
# 注意：脚本会替换URL认证参数/请求头/Cookie，可能导致本人正常登录失效。
# 仅用于隔离学习环境，勿在正常账号或支付/登录流程中启用。
# MITM范围按原配置保留；需自行启用MITM并信任证书。

[Script]
migu_vip_share_1 = type=http-request, pattern=^https?:\/\/(play|play-pre|v|v[0-9]?-sc|vmesh|app-sc|vms-sc|display(-sc)?|common-sc|program-sc|d[0-9]-sc|fs-sc|fsdv-sc|mp-user|recommend-dy|chat|chat-wx|public-deliver[0-9]?|public-operbiz[0-9]?|public-img)\.miguvideo\.com\/.+, requires-body=false, script-path=https://raw.githubusercontent.com/Polly-ai/Wynston/main/Surge/JavaScript/Migu/migu_vip.js, timeout=5
migu_vip_share_2 = type=http-request, pattern=^https?:\/\/(passport|uem|push|jadeite|jadeiteapp|hound|feedback|rcsdk)\.migu\.cn\/.+, requires-body=false, script-path=https://raw.githubusercontent.com/Polly-ai/Wynston/main/Surge/JavaScript/Migu/migu_vip.js, timeout=5

[MITM]
hostname = %APPEND% *.miguvideo.com, *.migu.cn
