#!name = 京东净化
#!desc = 适配京东 App 15.9.50+ 新协议(响应体 base64 化)的京东去广告插件。移除开屏广告、首页/我的/订单/物流页推广楼层、弹窗等。兼容新旧协议。适用京东 App >= 15.9.50（2026-08-12 验证）
#!category = Polly-ai
#!author = zbsdsb (基于 RuCu6/Maasea/kelee 原插件适配)
#!icon = https://raw.githubusercontent.com/luestr/IconResource/main/App_icon/120px/JD.png
#!openUrl = https://apps.apple.com/app/id414245413

# 转换自 Loon 插件格式，上游：https://raw.githubusercontent.com/zbsdsb/loon-adblock-plugins/main/JD_remove_ads_v2.lpx

[Rule]
URL-REGEX, "^http:\/\/\w{32}\.jddebug\.com\/diagnose\?", REJECT

[Script]
京东去广告v2 = type=http-response, pattern=^https:\/\/api\.m\.jd\.com\/client\.action, requires-body=true, script-path=https://raw.githubusercontent.com/Polly-ai/Wynston/main/Surge/JavaScript/JD_remove_ads_v2/JD_remove_ads_v2.js

[MITM]
hostname = %APPEND% api.m.jd.com
