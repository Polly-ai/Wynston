[Script]
mgtv_vip = type=http-request, pattern=^https?:\/\/mobile-stream\.api\.mgtv\.com\/v1\/video\/source, requires-body=false, script-path=https://raw.githubusercontent.com/Polly-ai/Wynston/main/Surge/JavaScript/MGTV/mgtv_vip.js, timeout=5

[MITM]
hostname = %APPEND% mobile-stream.api.mgtv.com
