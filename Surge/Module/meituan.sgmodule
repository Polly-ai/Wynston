IP-CIDR6,2405:1480:1000:3::1e/128,REJECT

[Script]
meituan_1 = type=http-response, pattern=^https?:\/\/apimobile\.meituan\.com\/aggroup\/indexTab, requires-body=true, script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/MT.js
meituan_2 = type=http-response, pattern=^https?:\/\/feedguess\.meituan\.com\/lycoris\/scene\/(gwc_feed1_2265|personalcenter_2154)(\?|$), requires-body=true, script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/MT.js
meituan_3 = type=http-response, pattern=^https?:\/\/mt-personalcenter\.meituan\.com\/usercenter\/display, requires-body=true, script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/MT.js
meituan_4 = type=http-response, pattern=^https?:\/\/apimobile\.meituan\.com\/group\/v1\/deal\/searchpage\/defaultword, requires-body=true, script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/MT.js
meituan_5 = type=http-response, pattern=^https?:\/\/apimobile\.meituan\.com\/group\/v1\/deal\/searchpage\/hotword\/city\/divide\/hotrecommend\/, requires-body=true, script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/MT.js
meituan_6 = type=http-response, pattern=^https?:\/\/assistify\.meituan\.com\/assistant\/getAppClientHornConfig, requires-body=true, script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/MT.js
meituan_7 = type=http-response, pattern=^https?:\/\/mop\.meituan\.com\/mop\/entry\/shoppingCartEntry, requires-body=true, script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/MT.js
meituan_8 = type=http-response, pattern=^https?:\/\/mop\.meituan\.com\/api\/entryModule\/startupPicture, requires-body=true, script-path=https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/MT.js

[MITM]
hostname = %APPEND%apimobile.meituan.com, feedguess.meituan.com, mop.meituan.com, mt-personalcenter.meituan.com, assistify.meituan.com
