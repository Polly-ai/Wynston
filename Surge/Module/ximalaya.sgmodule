#!name = 喜马拉雅净化
#!desc = 去除喜马拉雅 App 广告、推广弹窗与多余入口。
#!category = Polly-ai
#!author = ddgksf2013

# 转换自 QX 格式，上游：https://raw.githubusercontent.com/ddgksf2013/Rewrite/master/AdBlock/Ximalaya.conf
# 注意：上游 MITM 主机名含通配符 *.xima*.*、*.xmcdn.*，原文原样保留；Surge 对这种中间带 * 的主机名匹配方式未经真机验证。

[URL Rewrite]
# > XiMaLaYa_喜马拉雅_修复轮播Ad失效Bug
^https?:\/\/.*\.xima.*\.com\/discovery-feed\/focus\/queryF _ reject
# > XiMaLaYa_喜马拉雅_播放页_Live
^https?:\/\/.*\.xima.*\.com\/mobile-playpage\/view\/ _ reject
# > XiMaLaYa_喜马拉雅_MyInfo红点提醒
^https?:\/\/.*\.xima.*\.com\/chaos-notice-web\/v1\/message\/preview\/list _ reject
# > XiMaLaYa_喜马拉雅_屏蔽大红包Tips
^https?:\/\/.*\.xima.*\.com\/social-web\/bottomTabs\/dynamicEntrance\/status _ reject
# > XiMaLaYa_喜马拉雅_屏蔽gif弹窗Ad
^https?:\/\/.*\.xmcdn\.com\/\w{8}\/\w{4}-\w{16}\/.+gif$ _ reject
# > XiMaLaYa_喜马拉雅_gslb
^https?:\/\/gslb.*\.xima.*\.com\/ _ reject
# > XiMaLaYa_喜马拉雅_屏蔽Aged请求
^https?:\/\/.*\.xima.*\.com\/(dog-portal\/checkOld|(child-mobile\/child|aged-mobile\/aged)\/mode\/query) _ reject
# > XiMaLaYa_喜马拉雅_部分Tab弹窗
^https?:\/\/.*\.xima.*\.com\/discovery-feed\/isShowUserGiftPendant _ reject
# > XiMaLaYa_喜马拉雅_屏蔽红点提示
^https?:\/\/.*\.xima.*\.com\/mobile-user\/unread _ reject
# > XiMaLaYa_喜马拉雅_屏蔽minor请求
^https?:\/\/.*\.xima.*\.com/mobile-user/minorProtection/pop _ reject
# > XiMaLaYa_喜马拉雅_屏蔽隐私搜集
^https?:\/\/.*\.xima.*\.com\/collector\/xl\/v\d _ reject
# > XiMaLaYa_喜马拉雅_屏蔽版本更新
^https?:\/\/.*\.xima.*\.com\/butler-portal\/versionCheck _ reject
# > XiMaLaYa_喜马拉雅_屏蔽开屏广告
^https?:\/\/(adse\.wsa|adse|adbehavior|xdcs-collector)\.xima.*\.com\/.* _ reject
# > XiMaLaYa_喜马拉雅_屏蔽位置请求
^https?:\/\/.*\.xima.*\.com\/mobile\/discovery\/v\d\/location _ reject
# > XiMaLaYa_喜马拉雅_屏蔽热搜词
^https?:\/\/.*\.xima.*\.com\/(hub\/)?hotWord _ reject
# > XiMaLaYa_喜马拉雅_屏蔽热搜board
^https?:\/\/.*\.xima.*\.com\/(hub\/)?hotWordBillboard _ reject
# > XiMaLaYa_喜马拉雅_屏蔽搜索框定时_Ad
^https?:\/\/.*\.xima.*\.com\/(hub)?guideWord _ reject
# > XiMaLaYa_喜马拉雅_屏蔽实时Ad请求
^https?:\/\/.*\.xima.*\.com\/api\/v\d\/adRealTime _ reject
# > XiMaLaYa_喜马拉雅_屏蔽ting_Ad
^https?:\/\/.*\.xima.*\.com\/ting\/(loading|feed|home)? _ reject

[Script]
# > XiMaLaYa_喜马拉雅_首页顶部去除直播
ximalaya_1 = type=http-response, pattern=^https?:\/\/.*\.xima.*\.com\/discovery-category\/customCategories, requires-body=true, script-path=https://raw.githubusercontent.com/Polly-ai/Wynston/main/Surge/JavaScript/Ximalaya/ximalaya_json.js
# > XiMaLaYa_喜马拉雅_屏蔽首页横幅_Ad
ximalaya_2 = type=http-response, pattern=^https?:\/\/.*\.xima.*\.com\/focus-mobile\/focusPic, requires-body=true, script-path=https://raw.githubusercontent.com/Polly-ai/Wynston/main/Surge/JavaScript/Ximalaya/ximalaya_json.js
# > XiMaLaYa_喜马拉雅_屏蔽首页动态_Ad
ximalaya_3 = type=http-response, pattern=^https?:\/\/.*\.xima.*\.com\/discovery-feed\/v\d\/mix, requires-body=true, script-path=https://raw.githubusercontent.com/Polly-ai/Wynston/main/Surge/JavaScript/Ximalaya/ximalaya_json.js
# > XiMaLaYa_喜马拉雅_屏蔽Tab页滚动_Ad
ximalaya_4 = type=http-response, pattern=^https?:\/\/.*\.xima.*\.com\/discovery-category\/v\d/category, requires-body=true, script-path=https://raw.githubusercontent.com/Polly-ai/Wynston/main/Surge/JavaScript/Ximalaya/ximalaya_json.js
# > XiMaLaYa_喜马拉雅_去除我的页面Ad_Tag
ximalaya_5 = type=http-response, pattern=^https?:\/\/.*\.xima.*\.com\/mobile-user\/v\d\/homePage, requires-body=true, script-path=https://raw.githubusercontent.com/Polly-ai/Wynston/main/Surge/JavaScript/Ximalaya/ximalaya_json.js

[MITM]
hostname = %APPEND% *.xima*.*, *.xmcdn.*
