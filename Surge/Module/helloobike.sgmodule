#!name = 哈啰净化
#!desc = 净化弹窗、首页推荐流、借钱入口与会员领券横条，隐藏我的页推广宫格、推荐、奖励金、接单券提醒及钱包金融整排。
#!category = Polly-ai
#!author = TG@ZenMoFiShi

# 转换自 QX 格式，上游：https://raw.githubusercontent.com/ZenmoFeiShi/Qx/refs/heads/main/helloobike.snippet
# 脚本：上游 easybike-ad.js 经 Surge 适配后存于本仓库 Surge/Script/easybike-ad_surge.js，模块不直接指向 QX 原版；
# 其中 script-echo-response 在 Surge 下以 http-response 实现（覆盖上游响应，状态已改为数字）。

[Script]
helloobike_1 = type=http-response, pattern=^https:\/\/resource\.51downapp\.cn\/f414fbc17c411b4e986ba8891c738a49\.json\?(?:[^#]*&)?md5=e5230c919f7e3f3af3256161fbfaa0e2&(?:[^#]*&)?hbe_qx_ui=1\.3$, requires-body=true, script-path=https://raw.githubusercontent.com/Polly-ai/Wynston/refs/heads/main/Surge/Script/easybike-ad_surge.js
helloobike_2 = type=http-response, pattern=^https:\/\/api\.hellobike\.com(?::443)?\/secretkey(?:\?|$), requires-body=true, script-path=https://raw.githubusercontent.com/Polly-ai/Wynston/refs/heads/main/Surge/Script/easybike-ad_surge.js
helloobike_3 = type=http-request, pattern=^https?:\/\/(?:api|marketingapi|entertainment)\.hellobike\.com(?::\d+)?\/api(?:\?|$), requires-body=true, script-path=https://raw.githubusercontent.com/Polly-ai/Wynston/refs/heads/main/Surge/Script/easybike-ad_surge.js
helloobike_4 = type=http-response, pattern=^https?:\/\/(?:api|marketingapi|entertainment)\.hellobike\.com(?::\d+)?\/api(?:\?|$), requires-body=true, script-path=https://raw.githubusercontent.com/Polly-ai/Wynston/refs/heads/main/Surge/Script/easybike-ad_surge.js, max-size=4194304

[URL Rewrite]
^https?:\/\/api-htp\.beizi\.biz\/mb\/sdk0\/json(?:\?|$) _ reject-200
^https?:\/\/adservice\.sigmob\.cn\/(?:hb\/v2\/ad|ad\/v4)(?:\?|$) _ reject-200
^https?:\/\/tm\.sigmob\.cn\/(?:waterfall\/v1|strategy\/v6)(?:\?|$) _ reject-200
^https?:\/\/(?:mi|v2mi)\.gdt\.qq\.com\/(?:gdt_mview\.fcg|server_bidding2)(?:\?|$) _ reject-200

[MITM]
hostname = %APPEND% api.hellobike.com, marketingapi.hellobike.com, entertainment.hellobike.com, api-htp.beizi.biz, adservice.sigmob.cn, tm.sigmob.cn, mi.gdt.qq.com, v2mi.gdt.qq.com, resource.51downapp.cn
