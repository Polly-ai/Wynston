#!name = 路由追踪
#!desc = 当前节点路由追踪与落地（监测点西安/重庆/武汉/国内电信，面板显示地理位置路径段与落地点）
#!category = Polly-ai

[Panel]
route_check2 = title="路由追踪",content="轻点刷新查看路由",script-name=route_check2,icon=point.topleft.down.to.point.bottomright.curvepath,icon-color=#BF5AF2

[Script]
route_check2 = type=generic,script-path=https://raw.githubusercontent.com/Polly-ai/Wynston/refs/heads/main/Surge/Script/route_check_surge.js,timeout=120
